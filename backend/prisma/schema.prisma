datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String    @id @default(cuid())
  nombre    String
  email     String    @unique
  password  String
  telefono  String?
  ubicacion String?
  avatarUrl String?   @map("avatar_url")
  rol       Rol       @default(ESTUDIANTE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reservas  Reserva[]
  horariosSemanales HorarioSemanalEstudiante[]
  horariosConducidos Horario[] @relation("ConductorHorarios")
}

model Ruta {
  id        String     @id @default(cuid())
  nombre    String
  origen    String
  destino   String
  activa    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  horarios  Horario[]
}

model Horario {
  id         String     @id @default(cuid())
  rutaId     String
  ruta       Ruta       @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  conductorId String?
  conductor  Usuario?   @relation("ConductorHorarios", fields: [conductorId], references: [id], onDelete: SetNull)
  salida     DateTime
  llegada    DateTime?
  cupoTotal  Int
  cupoOcupado Int        @default(0)
  activo     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  reservas   Reserva[]

  @@index([conductorId])
}

model Reserva {
  id         String     @id @default(cuid())
  usuarioId  String
  horarioId  String
  diaSemana  DiaSemana?
  esSemanal  Boolean    @default(false)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  horario    Horario    @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  estado     EstadoReserva @default(ACTIVA)
  codigo     String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([usuarioId, horarioId, diaSemana])
}

model HorarioSemanalEstudiante {
  id             String    @id @default(cuid())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dia            DiaSemana
  viaja          Boolean   @default(true)
  primeraEntrada String?
  ultimaSalida   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([usuarioId, dia])
  @@index([usuarioId])
}

enum Rol {
  ESTUDIANTE
  CONDUCTOR
  ADMIN
}

enum EstadoReserva {
  ACTIVA
  CANCELADA
  COMPLETADA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
}
