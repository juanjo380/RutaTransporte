{
  "name": "ruta-transporte-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node scripts/seed-users.js --mode=upsert",
    "seed:horarios": "node scripts/seed-horarios.js",
    "seed:all": "npm run seed && npm run seed:horarios",
    "reservas:clear:user": "node scripts/clear-user-reservas.js",
    "seed:create": "node scripts/seed-users.js --mode=create",
    "seed:upsert": "node scripts/seed-users.js --mode=upsert",
    "seed:sync": "node scripts/seed-users.js --mode=sync"
  },
  "_seedNotes": {
    "create": "Crear solo nuevos: npm run seed:create",
    "upsert": "Crear o actualizar existentes: npm run seed o npm run seed:upsert",
    "sync": "Sincronizar exacto (crear, actualizar y eliminar no listados): npm run seed:sync"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/config": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0"
  }
}


